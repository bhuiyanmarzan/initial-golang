ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:mylocaldb@localhost:5433/olx_api?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:mylocaldb@localhost:5433/olx_api?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
AUTH_RATE_LIMIT_RPM=10
AUTH_RATE_LIMIT_BURST=5
USER_RATE_LIMIT_RPM=300
USER_RATE_LIMIT_BURST=60
RATE_LIMIT_MAX_CLIENTS=10000
# Required with RATE_LIMIT_BACKEND=redis; use rediss:// for TLS.
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=eghissab:ratelimit
# Empty for direct access. Trust only the immediate proxy and known upstream hops.
AUTH_TRUSTED_PROXY_CIDRS=
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=15s
