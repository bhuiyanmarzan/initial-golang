# Include within an nginx http {} block. Configure public TLS separately.
# This example assumes nginx is directly internet-facing (no Cloudflare).
upstream eghissab_api {
    server 127.0.0.1:8080;
    keepalive 16;
}
server {
    listen 80;
    server_name app.example.com admin.example.com portal.example.com;
    client_max_body_size 1m;
    location = /readyz {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://eghissab_api;
    }
    location /api/ {
        proxy_pass http://eghissab_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarded addresses at this edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }
}
